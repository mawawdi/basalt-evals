  "deterministic": [
    {
      "id": "server-source",
      "layer": "static",
      "statement": "A server mechanic source exists.",
      "required": true,
      "rule": {
        "kind": "path_exists",
        "path": "src/server/BombServer.server.luau"
      }
    },
    {
      "id": "client-source",
      "layer": "static",
      "statement": "A client input/presentation source exists.",
      "required": true,
      "rule": {
        "kind": "path_exists",
        "path": "src/client/BombClient.client.luau"
      }
    },
    {
      "id": "real-pass-input",
      "layer": "engine",
      "statement": "The holder's real E input was delivered.",
      "required": true,
      "rule": {
        "kind": "scenario_action_succeeded",
        "scenarioId": "legitimate-pass",
        "stepId": "press-pass",
        "actor": "holder"
      }
    },
    {
      "id": "near-pass-start-owner",
      "layer": "engine",
      "statement": "The legitimate-pass scenario begins with the declared holder.",
      "required": true,
      "rule": {
        "kind": "scenario_fact_equals_actor_user_id",
        "scenarioId": "legitimate-pass",
        "stepId": "before-pass",
        "context": "server",
        "factId": "owner",
        "actor": "holder"
      }
    },
    {
      "id": "near-pass-owner",
      "layer": "engine",
      "statement": "A nearby pass transfers server ownership to the receiver.",
      "required": true,
      "rule": {
        "kind": "scenario_fact_equals_actor_user_id",
        "scenarioId": "legitimate-pass",
        "stepId": "after-pass",
        "context": "server",
        "factId": "owner",
        "actor": "receiver"
      }
    },
    {
      "id": "near-pass-replicates",
      "layer": "engine",
      "statement": "Server and both clients converge on the same holder.",
      "required": true,
      "rule": {
        "kind": "scenario_cross_context_equals",
        "scenarioId": "legitimate-pass",
        "stepId": "after-pass",
        "factId": "owner",
        "field": "value",
        "contexts": ["server", "holder", "receiver"]
      }
    },
    {
      "id": "fuse-preserved",
      "layer": "engine",
      "statement": "Passing does not reset the fuse deadline.",
      "required": true,
      "rule": {
        "kind": "scenario_number_delta_in_range",
        "scenarioId": "legitimate-pass",
        "context": "server",
        "fromStepId": "before-pass",
        "fromFactId": "deadline",
        "toStepId": "after-pass",
        "toFactId": "deadline",
        "field": "value",
        "minimum": -0.001,
        "maximum": 0.001
      }
    },
    {
      "id": "range-rejected",
      "layer": "engine",
      "statement": "An out-of-range input leaves ownership with the holder.",
      "required": true,
      "rule": {
        "kind": "scenario_fact_equals_actor_user_id",
        "scenarioId": "out-of-range",
        "stepId": "after-attempt",
        "context": "server",
        "factId": "owner",
        "actor": "holder"
      }
    },
    {
      "id": "forgery-rejected",
      "layer": "engine",
      "statement": "A forged client-selected receiver leaves ownership unchanged.",
      "required": true,
      "rule": {
        "kind": "scenario_fact_equals_actor_user_id",
        "scenarioId": "forged-request",
        "stepId": "after-forge",
        "context": "server",
        "factId": "owner",
        "actor": "holder"
      }
    },
    {
      "id": "expiration-damages",
      "layer": "engine",
      "statement": "Expiration damages the authoritative holder.",
      "required": true,
      "rule": {
        "kind": "scenario_number_delta_in_range",
        "scenarioId": "expiration",
        "context": "server",
        "fromStepId": "armed",
        "fromFactId": "health",
        "toStepId": "expired",
        "toFactId": "health",
        "field": "value",
        "minimum": -100,
        "maximum": -1
      }
    },
    {
      "id": "single-explosion",
      "layer": "engine",
      "statement": "Expiration produces exactly one stable explosion count.",
      "required": true,
      "rule": {
        "kind": "scenario_fact_equals",
        "scenarioId": "expiration",
        "stepId": "expired",
        "context": "server",
        "factId": "explosions",
        "field": "value",
        "expected": 1
      }
