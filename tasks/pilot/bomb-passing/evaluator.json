          "kind": "wait_for_fact",
          "readyFactId": "status",
          "readyValue": "armed",
          "timeoutMs": 30000
        },
        "facts": [
          {
            "id": "status",
            "kind": "replication_probe",
            "path": "game.ReplicatedStorage.BombState",
            "attribute": "Status"
          },
          {
            "id": "owner",
            "kind": "replication_probe",
            "path": "game.ReplicatedStorage.BombState",
            "attribute": "HolderUserId"
          },
