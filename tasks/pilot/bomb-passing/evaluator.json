            "id": "status-text",
            "kind": "gui_text",
            "path": "game.Players.LocalPlayer.PlayerGui.BombGui.Panel.Status"
          },
          {
            "id": "errors",
            "kind": "diagnostics"
          }
        ],
        "captures": [
